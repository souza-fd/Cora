// Controle manual dos motores
void controle_velocidade(int P1, int P2, int P3, int P4){
  P1 = int(P1);
  P2 = int(P2);
  P3 = int(P3);
  P4 = int(P4);
  analogWrite(IN1, P1);
  analogWrite(IN2, P2);
  analogWrite(IN3, P3);
  analogWrite(IN4, P4);
}

// Realinhamento para a direita
void realinharDir(unsigned long timeAtual, unsigned long timeAnteriorBLE) {
  while(1){
    timeAtual = millis();
    // Leitura dos sensores
    int sensor1 = !digitalRead(SENSOR1_PIN);
    int sensor2 = !digitalRead(SENSOR2_PIN);
    int sensor3 = !digitalRead(SENSOR3_PIN);
    int sensor4 = !digitalRead(SENSOR4_PIN);
    int sensor5 = !digitalRead(SENSOR5_PIN);
    int sensor6 = !digitalRead(SENSOR6_PIN);
    int sensor7 = !digitalRead(SENSOR7_PIN);
    int sensor8 = !digitalRead(SENSOR8_PIN);
    int sensor9 = !digitalRead(SENSOR9_PIN);

    controle_velocidade(255, 0, 0, 80);

  // Enviar leitura por bluetooth
    if (deviceConnected) {
      // Monta string manualmente
      String sensorData = "";
      sensorData += String(sensor1) + "";
      sensorData += String(sensor2) + "-";
      sensorData += String(sensor3) + "";
      sensorData += String(sensor4) + "";
      sensorData += String(sensor5) + "";
      sensorData += String(sensor6) + "";
      sensorData += String(sensor7) + "-";
      sensorData += String(sensor8) + "";
      sensorData += String(sensor9) + "  ";
      sensorData += "E" + String(estado);

      if(timeAtual - timeAnteriorBLE >= int(1000/amostragem_BLE)){ 
        Serial.println(sensorData);  // Também mostra no Serial Monitor
        pCharacteristic->setValue(sensorData.c_str());
        pCharacteristic->notify();
        timeAnteriorBLE = timeAtual;
      }
    }

    // Transição para voltar à linha 
    if((sensor4 == 1 || sensor5 == 1 || sensor6 == 1) && sensor7 == 0 && sensor8 == 0 && sensor9 == 0)
      break;
  }
}

