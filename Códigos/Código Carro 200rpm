// Atribuição de pesos para cada sensor
int atribuirErro(int sensor1, int sensor2, int sensor3, int sensor4, int sensor5, int sensor6, int sensor7, int sensor8, int sensor9){
  int erro = 0;
  if(sensor8 == 1 && sensor2 == 1)
    erro = 0;
  else if(sensor7 == 1 && sensor3 == 1)
    erro = 0;
  else if(sensor6 == 1 && sensor4 == 1)
    erro = 0;
  else if(sensor5 == 1 && sensor6 == 0 && sensor4 == 0)
    erro = 0;
  else if(sensor1 == 0 && sensor2 == 0 && sensor3 == 0 && sensor4 == 0 && sensor5 == 0 && sensor6 == 0 && sensor7 == 0 && sensor8 == 1)
    erro = +3;
  else if(sensor2 == 1 && sensor3 == 0 && sensor4 == 0 && sensor5 == 0 && sensor6 == 0 && sensor7 == 0 && sensor8 == 0 && sensor9 == 0)
    erro = -3;
  else if(sensor7 == 1)
    erro = +3;
  else if(sensor3 == 1)
    erro = -3;
  else if(sensor6 == 1)
    erro = +1;
  else if(sensor4 == 1)
    erro = -1;

  return erro;
}

// Controle PID dos motores a partir do erro
void controle_PID(int erro, int erroAnterior, int integral, int velBase){

  int ajuste = int(Kp * (erro) + Kd * (erro - erroAnterior) + Ki * (integral));
  int velEsq = int(velBase + ajuste);
  int velDir = int(velBase - ajuste);

  velEsq = constrain(velEsq, 0, 255);
  velDir  = constrain(velDir, 0, 255);
  controle_velocidade(velEsq, 0, velDir, 0);


