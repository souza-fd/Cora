// Virar pra direita 
void virar90Dir(){
  //continua
  controle_velocidade(150, 0, 150, 0);
  delay(150);
  //vira crescentemente 
  controle_velocidade(180, 0, 0, 80);
  delay(200);
  controle_velocidade(255, 0, 0, 80);
  delay(100);
  controle_velocidade(255, 0, 0, 0);
  delay(50);
  controle_velocidade(255, 0, 100, 0);
  delay(50);
}

// Virar pra esquerda 
void virar90Esq(){
  //continua
  controle_velocidade(150, 0, 150, 0);
  delay(150);
  //vira crescentemente 
  controle_velocidade(0, 80, 180, 0);
  delay(200);
  controle_velocidade(0, 80, 255, 0);
  delay(100);
  controle_velocidade(0, 0, 255, 0);
  delay(50);
  controle_velocidade(100, 0, 255, 0);
  delay(50);
}

// Anda o mais reto possível
void andarReto(){
  int velEsq = int(velBase_Global);
  int velDir = int(0.95 * velBase_Global);
  controle_velocidade(velEsq, 0, velDir, 0);
}

// Aumenta a tensão gradualmente
void partidaSuave(){
  int velEsq;
  int velDir;

  //parado inicialmente
  controle_velocidade(0, 0, 0, 0);
  delay(200);

  //partida
  int velBase = 55;
  controle_velocidade(velBase, 0, velBase, 0);
  delay(150);

  //aceleração
  for(int i=55; i<=velBase_Global; i+=5){
    velBase = i;
    velEsq = int(velBase);
    velDir = int(velBase);
    controle_velocidade(velEsq, 0, velDir, 0);
    delay(10);
  }

  //velocidade final
  velBase = velBase_Global;
  velEsq = int(velBase);
  velDir = int(velBase);
  controle_velocidade(velEsq, 0, velDir, 0);
  delay(150);
}

// Atribuição de pesos quando ler quadrado
int atribuirErro_simples(int sensor1, int sensor2, int sensor3, int sensor4, int sensor5, int sensor6, int sensor7, int sensor8, int sensor9){
  int erro = 0;
  if(sensor1 == 0 && sensor2 == 0 && sensor3 == 1 && sensor4 == 1)
    erro = -5;
  else if(sensor6 == 1 && sensor7 == 1 && sensor8 == 0 && sensor9 == 0)
    erro = +5;
  else if(sensor6 == 1 && sensor4 == 1)
    erro = 0;
  else if(sensor5 == 1 && sensor6 == 0 && sensor4 == 0)
    erro = 0;
  else if(sensor6 == 1)
    erro = +1;
  else if(sensor4 == 1)
    erro = -1;

  return erro;
}

// Atribuição de pesos na pista invertida
int atribuirErro_PistaInvertida(int sensor1, int sensor2, int sensor3, int sensor4, int sensor5, int sensor6, int sensor7, int sensor8, int sensor9, int erroAnterior){
  int erro = 0;
  if(sensor1 == 1 && sensor2 == 1 && sensor3 == 1 && sensor4 == 1 && sensor5 == 1 && sensor6 == 1 && sensor7 == 1 && sensor8 == 1 && sensor9 == 1)
    erro = erroAnterior;
  else if(sensor8 == 1 && sensor2 == 1)
    erro = 0;
  else if(sensor7 == 1 && sensor3 == 1)
    erro = 0;
  else if(sensor6 == 1 && sensor4 == 1)
    erro = 0;
  else if(sensor5 == 1 && sensor6 == 0 && sensor4 == 0)
    erro = 0;
  else if(sensor1 == 0 && sensor2 == 0 && sensor3 == 0 && sensor4 == 0 && sensor5 == 0 && sensor6 == 0 && sensor7 == 0 && sensor8 == 1)
    erro = +3;
  else if(sensor2 == 1 && sensor3 == 0 && sensor4 == 0 && sensor5 == 0 && sensor6 == 0 && sensor7 == 0 && sensor8 == 0 && sensor9 == 0)
    erro = -3;
  else if(sensor7 == 1)
    erro = +3;
  else if(sensor3 == 1)
    erro = -3;
  else if(sensor6 == 1)
    erro = +1;
  else if(sensor4 == 1)
    erro = -1;

  return erro;
}


